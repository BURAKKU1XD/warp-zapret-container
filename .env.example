# Published image with bundled strategies, lists and fake payloads.
# Set a version tag or sha-<commit> instead of latest to pin a release.
WARP_ZAPRET_IMAGE=ghcr.io/burakku1xd/warp-zapret-container:latest

# See README.md or run the image with --list-strategies for all 22 names.
ZAPRET_STRATEGY=general
